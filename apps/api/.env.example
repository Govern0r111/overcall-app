APP_ENV=development
PORT=8000
DATABASE_URL=postgresql+asyncpg://overcall:overcall@localhost:54329/overcall
TEST_DATABASE_URL=postgresql://overcall:overcall@localhost:54329/overcall
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
INGEST_KEY_PEPPER=
INGEST_KEY_PEPPER_PREV=
INTERNAL_TOKEN=
CORS_ORIGINS=http://localhost:5173
PUBLIC_PROXY_BASE_URL=http://localhost:8000
ALLOW_REAL_UPSTREAM=false
OPENAI_UPSTREAM_BASE_URL=https://api.openai.com
STRIPE_UPSTREAM_BASE_URL=https://api.stripe.com
MAX_REQUEST_BODY_BYTES=10485760
MAX_RESPONSE_BUFFER_BYTES=20971520
LOG_QUEUE_MAX=5000
LOG_BATCH_SIZE=200
LOG_FLUSH_INTERVAL_MS=1000
RATE_LIMIT_PROXY_RPS=50
RATE_LIMIT_API_RPM=120
MAX_INFLIGHT=100
LOG_RETENTION_DEFAULT_DAYS=14
MAX_LOGS_PER_USER=100000
TIKTOKEN_CACHE_DIR=.tiktoken
LOG_LEVEL=INFO
RELEASE=local
